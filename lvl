--------------------------------------------------------------------------------
-- LOADING SCREEN WAIT
--------------------------------------------------------------------------------
-- game:IsLoaded() only means the engine finished replicating; the game's own loading
-- screen can stay up much longer. There is no fixed delay and no timeout: it waits until ALL of
-- these hold on two checks in a row (0.25s apart, only to ignore a one-frame flicker):
--   1. the character exists (HumanoidRootPart + Humanoid)
--   2. ReplicatedStorage.Stats<name> exists (the save data has replicated)
--   3. the HUD's "Level N" label exists (what getPlayerLevel reads)
--   4. the loading screen is gone: a ScreenGui in PlayerGui / ReplicatedFirst whose name is in
--      Loading.GuiNames (default "LoadingGUI") or contains "load" still has a VISIBLE FULL-SCREEN
--      FRAME. The game never disables or removes LoadingGUI, it only hides that frame (~11s in)
local function waitForLoadingScreen()
    local cfg = getgenv().Config.Loading or {}
    if cfg.Enabled == false then return end
    local plr = game:GetService("Players").LocalPlayer
    local RS = game:GetService("ReplicatedStorage")
    local RF = game:GetService("ReplicatedFirst")
    local pg = plr:WaitForChild("PlayerGui")

    local explicit = {}
    for _, n in ipairs(cfg.GuiNames or {}) do explicit[string.lower(n)] = true end

    local function visibleChain(obj, stopAt)
        local cur = obj
        while cur and cur ~= stopAt do
            if cur:IsA("GuiObject") and not cur.Visible then return false end
            cur = cur.Parent
        end
        return true
    end

    -- A visible full-screen frame. This is what the recorder measured on the game's LoadingGUI
    -- (sea 1 and sea 2): the ScreenGui stays Enabled and parented the whole time, text goes
    -- "Loading Player Info..." -> "Loading Data" -> "Loaded!", and the full-screen frame is
    -- visible for ~11s and then hidden / faded. So "is it still there" = "is that frame still showing".
    local function hasCover(gui)
        local size = gui.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then return false end
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiObject") and d.BackgroundTransparency < 0.95 and visibleChain(d, gui) then
                local s = d.AbsoluteSize
                if s.X >= size.X * 0.9 and s.Y >= size.Y * 0.9 then return true end
            end
        end
        return false
    end

    local function loadingShowing()
        for _, root in ipairs({ pg, RF }) do
            for _, gui in ipairs(root:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    local lname = string.lower(gui.Name)
                    if (explicit[lname] or string.find(lname, "load", 1, true)) and hasCover(gui) then
                        return true
                    end
                end
            end
        end
        -- (no scan of "load" elements inside other GUIs: Inventory has "Loadout" frames, which
        -- the recorder flagged as a false positive)
        return false
    end

    local function hudReady()
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") and string.match(d.Text, "^Level%s*%d+$") then return true end
        end
        return false
    end

    local function ready()
        local char = plr.Character
        if not (char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid")) then return false end
        if not RS:FindFirstChild("Stats" .. plr.Name) then return false end
        if not hudReady() then return false end
        return not loadingShowing()
    end

    local t0, streak = os.clock(), 0
    while true do
        if ready() then
            streak = streak + 1
            if streak >= 2 then
                print(string.format("[quest] loading screen gone after %.1fs", os.clock() - t0))
                return
            end
        else
            streak = 0
        end
        task.wait(0.25)
    end
end


