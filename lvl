local function executeSecondPlaceSequence()
    local playerGui = player:WaitForChild("PlayerGui")

    local function isElementVisible(guiObject)
        if not guiObject then return false end
        local current = guiObject
        while current and current:IsA("GuiObject") do
            if not current.Visible then return false end
            current = current.Parent
        end
        return current and current:IsA("LayerCollector") and current.Enabled or false
    end

    local function clickButton(btn)
        if not btn then return false end
        
        if firesignal then
            pcall(function() firesignal(btn.MouseButton1Click) end)
            pcall(function() firesignal(btn.Activated) end)
            pcall(function() firesignal(btn.MouseButton1Down) end)
            pcall(function() firesignal(btn.MouseButton1Up) end)
        end
        if getconnections then
            for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                pcall(function() conn:Fire() end)
            end
            for _, conn in ipairs(getconnections(btn.Activated)) do
                pcall(function() conn:Fire() end)
            end
        end

        pcall(function()
            local absPos = btn.AbsolutePosition
            local absSize = btn.AbsoluteSize
            local centerX = absPos.X + (absSize.X / 2)
            local centerY = absPos.Y + (absSize.Y / 2) + 36
            
            VirtualInputManager:SendMouseMoveEvent(centerX, centerY, game)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        end)

        return true
    end

    local function waitForAndFindVisibleButton(searchText, timeout)
        local start = os.clock()
        local searchLower = string.lower(searchText)
        
        while (os.clock() - start) < (timeout or 15) do
            for _, desc in ipairs(playerGui:GetDescendants()) do
                if isElementVisible(desc) then
                    if desc:IsA("GuiButton") then
                        if string.find(string.lower(desc.Name), searchLower) or (desc:IsA("TextButton") and string.find(string.lower(desc.Text), searchLower)) then
                            return desc
                        end
                    elseif desc:IsA("TextLabel") and string.find(string.lower(desc.Text), searchLower) then
                        local parentBtn = desc:FindFirstAncestorWhichIsA("GuiButton")
                        if parentBtn and isElementVisible(parentBtn) then
                            return parentBtn
                        end
                    end
                end
            end
            task.wait(0.1)
        end
        return nil
    end

    task.wait(1)

    if targetPSCode then
        print("[SYSTEM] Attempting to join Private Server code: " .. targetPSCode)
        task.spawn(function()
            local reservedEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("reserved")
            pcall(function()
                reservedEvent:InvokeServer(targetPSCode)
            end)
        end)
    end

    local regularBtn = waitForAndFindVisibleButton("regular", 15)
    if regularBtn then
        task.wait(0.4)
        clickButton(regularBtn)
    end

    local secondSeaBtn = waitForAndFindVisibleButton("second", 15)
    if secondSeaBtn then
        task.wait(0.4)
        clickButton(secondSeaBtn)
    end
end

