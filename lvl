                    end
                end
            end
        end)
        return level > 0 and level or 40
    end

    -- Reads the real ownership flag: Skills.<name> is a BoolValue (true = owned).
    -- Geppo's trainer is "skyWalkTrainer", so its flag is Skills.skyWalk, NOT a "geppo" key.
    -- Looked up under the player's Stats folder in ReplicatedStorage first (where Peli lives),
    -- then under the player itself, so it works wherever the Skills folder sits.
    local SKILL_FLAG = { geppo = "skyWalk" }

    local function checkSkillOwned(skillName)
        local flagName = SKILL_FLAG[string.lower(skillName)] or skillName
        local roots = {
            ReplicatedStorage:FindFirstChild("Stats" .. player.Name),
            player,
        }
        for _, root in ipairs(roots) do
            if root then
                local skills = root:FindFirstChild("Skills", true)
                local flag = skills and skills:FindFirstChild(flagName)
                if flag and flag:IsA("BoolValue") then
                    return flag.Value == true
                end
            end
        end
        return false
    end

    -- GEPPO OWNERSHIP. checkSkillOwned is now a cheap value read, so a "no" is cached for
    -- GEPPO_RECHECK seconds and a "yes" is kept for good.
    local GEPPO_RECHECK = 15
    local geppoOwnedCached = false
    local geppoLastOwnedCheck = -1e9
    local function geppoOwned(force)
        if geppoOwnedCached then return true end
        if not force and tick() - geppoLastOwnedCheck < GEPPO_RECHECK then return false end
        geppoLastOwnedCheck = tick()
        if checkSkillOwned("geppo") then geppoOwnedCached = true end
        return geppoOwnedCached
    end

    -- The tier for a level. The Fishman tier (PathToRobo) is held back while Geppo is wanted
    -- but not owned: it keeps farming Gravito until Geppo is bought AND the level is reached.
    local function getConfigForLevel(level)
        -- below the first tier (e.g. an unreadable level in sea 2) -> tier 1; above the last -> the last tier
        local found = (level < QUEST_CONFIG[1].MinLevel) and QUEST_CONFIG[1] or QUEST_CONFIG[#QUEST_CONFIG]
        for _, q in ipairs(QUEST_CONFIG) do
            if level >= q.MinLevel and level <= q.MaxLevel then found = q break end
        end
        if found.PathToRobo and getgenv().Config.AutoGet.Geppo and not geppoOwned() then
            for _, g in ipairs(QUEST_CONFIG) do
                if g.QuestName == "Help Miska" then return g end
            end
        end
        return found
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.X then
            isRunning = false; hasQuest = false; isTraveling = false
            stopHoverPhysics()
            notify("Auto Farm", "Stopped via Kill Switch.", 3)
        end
    end)

    task.spawn(function()
        while isRunning do
            task.wait(5)
            if getPlayerLevel() >= getgenv().Config.StopOnLVL then
                isRunning = false
                if getgenv().Config.OnStopLVL == "Kick" then
                    player:Kick("Auto-Farm Stopped: Reached Target Level " .. getgenv().Config.StopOnLVL)
                elseif getgenv().Config.OnStopLVL == "Shutdown" then
                    game:Shutdown()
                end
            end
        end
    end)

    --------------------------------------------------------------------------
    -- AUTO STAT POINTS
    --------------------------------------------------------------------------
    -- Pressing "+" on a stat is a TextButton named Add inside its row:
    --   PlayerGui.Statistics.Main.Stats.<Stat>.Add        (TextButton, "+")
    --   PlayerGui.Statistics.Main.Stats.<Stat>.Amount     (current value)
    --   PlayerGui.Statistics.Main.TopOptions.AvailableSP  ("Skill Points: 12")
    --
    -- Rather than guess at what Events.SkillPoint expects, this fires the
    -- game's OWN Activated handler, so the client sends exactly the request it
    -- would send if you clicked. Verified live: one fire took Strength 75 -> 76
    -- and the counter 12 -> 11.
    --
    -- Verified too that it works with the panel CLOSED (Statistics.Enabled =
    -- false), and that AvailableSP still updates while closed -- so this never
    -- has to open the UI or interrupt farming.
    local function availablePoints()
        local ok, n = pcall(function()
            local gui = player.PlayerGui:FindFirstChild("Statistics")
            local main = gui and gui:FindFirstChild("Main")
            local top = main and main:FindFirstChild("TopOptions")
            local label = top and top:FindFirstChild("AvailableSP")
            if not label then return nil end
            return tonumber(string.match(label.Text, "%d+"))
        end)
        return ok and n or nil
    end

    local function pressAddOn(statName)
        local ok = pcall(function()
            local gui = player.PlayerGui:FindFirstChild("Statistics")
            local main = gui and gui:FindFirstChild("Main")
            local rows = main and main:FindFirstChild("Stats")
            local row = rows and rows:FindFirstChild(statName)
            local btn = row and row:FindFirstChild("Add")
            if not btn then error("no Add button on " .. tostring(statName)) end

            local conns = getconnections and getconnections(btn.Activated)
            if not conns or #conns == 0 then error("no Activated handler") end
            for _, c in ipairs(conns) do c:Fire() end
        end)
        return ok
    end

    task.spawn(function()
        local cfg = getgenv().Config.AutoStat
        if not (cfg and cfg.Enabled) then return end

        if not getconnections then
            notify("Auto Stat", "Executor has no getconnections - auto stat disabled.", 6)
            return
        end

        local warnedMissing = false

        while isRunning do
            task.wait(cfg.Interval or 10)

            local points = availablePoints()
            if not points then
                if not warnedMissing then
                    warnedMissing = true
                    notify("Auto Stat", "Statistics panel not readable yet - will keep trying.", 4)
                end
            elseif points > 0 then
                warnedMissing = false
                local spent = 0
                -- The active tier decides where points go (tier Stat override,
                -- Config.AutoStat.Stat as the fallback). Decided by LEVEL, not by
                -- the farm loop's current tier, so it is right even mid-transition;
                -- re-read every check, so crossing 425 flips Defense -> Strength
                -- within one interval.
                local tier = getConfigForLevel(getPlayerLevel())
                local stat = (tier and tier.Stat) or cfg.Stat

                -- One point at a time, re-reading the counter after each. If it
                -- does not go down the press was refused, so stop rather than
                -- spin on a button that is not taking.
                while isRunning and points > 0 do
                    if not pressAddOn(stat) then break end
                    task.wait(0.35)

                    local after = availablePoints()
                    if not after or after >= points then break end

                    points = after
                    spent = spent + 1
                end

                if spent > 0 then
                    notify("Auto Stat", string.format("Put %d point%s into %s.",
                        spent, spent == 1 and "" or "s", stat), 3)
                end
            end
        end
    end)
