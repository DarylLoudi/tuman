--------------------------------------------------------------------------------
-- 1) the Seated state is switched OFF on the humanoid, so a seat cannot seat us at all;
-- 2) fallback: if we end up seated anyway, drop the seat weld, un-sit and jump out of it.
local function antiSit(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)

    local function standUp()
        if not hum.Sit and not hum.SeatPart then return end
        pcall(function()
            local seat = hum.SeatPart
            local weld = seat and seat:FindFirstChild("SeatWeld")
            if weld then weld:Destroy() end
        end)
        hum.Sit = false
        hum.Jump = true
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end

    hum:GetPropertyChangedSignal("Sit"):Connect(standUp)
    hum.Seated:Connect(function(active) if active then standUp() end end)
    standUp() -- already seated when the script started / the character spawned
end
player.CharacterAdded:Connect(antiSit)
