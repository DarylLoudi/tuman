    -- BOSSROTATION'S TRAVEL (travelTo), ported from BossRotation.lua
    --------------------------------------------------------------------------
    -- Ground travel: a BodyVelocity with Y exactly zero for the horizontal, the
    -- root CFrame translated to follow the ground (probing underfoot and 16
    -- studs ahead), a geppo climb over steps/cliffs, ceiling and overhang
    -- handling with sidestep detours, and NO noclip -- it never writes
    -- CanCollide. safeMoveTo (below) uses it for normal moves; the underwater
    -- Fishman moves (ignoreYLimit) keep the old straight-line code, because this
    -- one rides the sea surface and cannot go under it.
    -- Speed comes from Config.Speed.Default, not BossRotation's own number.
    local TWN = {}
    do
        local RS = ReplicatedStorage
        local T = {}
        local function log(fmt, ...)
            local ok, msg = pcall(string.format, "[TWN] " .. fmt, ...)
            print(ok and msg or ("[TWN] " .. tostring(fmt)))
        end
        local function parts()
            local char = player.Character
